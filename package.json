{
  "name": "code-rr",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "build:storybook": "storybook build",
    "dev": "react-router dev",
    "format": "prettier \"{,!(node_modules)/**/}*.js\"",
    "format:write": "prettier \"*/**/*.{js,jsx,ts,tsx,json,md,css,scss}\" --write",
    "lint": "run-p lint:*",
    "lint:js": "eslint \"*/**/*.{js,jsx,ts,tsx}\" --fix",
    "lint:css": "stylelint \"./**/*.{css,scss}\" --fix",
    "lint:ts": "tsc -p tsconfig.json --noEmit && npm run typecheck",
    "new:c": "cross-env HYGEN_TMPLS=generators hygen new component",
    "typecheck": "react-router typegen && tsc",
    "prepare": "husky",
    "start": "react-router-serve ./build/server/index.js",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:pre-commit": "vitest run --changed",
    "test:report": "vitest --reporter=html",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6006"
  },
  "dependencies": {
    "@graphcms/rich-text-react-renderer": "^0.6.2",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@hygraph/preview-sdk": "^1.0.7",
    "@react-router/fs-routes": "^7.15.1",
    "@react-router/node": "7.15.1",
    "@react-router/serve": "7.15.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "graphql": "^16.14.0",
    "graphql-request": "^7.4.0",
    "isbot": "^5.1.40",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "7.15.1",
    "react-syntax-highlighter": "^16.1.1"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.3",
    "@chromatic-com/storybook": "^5.2.1",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@react-router/dev": "7.15.1",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/addon-onboarding": "^10.4.0",
    "@storybook/addon-vitest": "^10.4.0",
    "@storybook/react-vite": "^10.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitejs/devtools": "^0.2.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser-playwright": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.7",
    "autoprefixer": "^10.5.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.4.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-deprecation": "^3.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.4.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "husky": "^9.1.7",
    "hygen": "^6.2.11",
    "install": "^0.13.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "msw": "^2.14.6",
    "npm": "^11.15.0",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.60.0",
    "postcss": "^8.5.15",
    "postcss-custom-media": "^12.0.1",
    "postcss-loader": "^8.2.1",
    "postcss-preset-env": "^11.3.0",
    "postcss-safe-parser": "^7.0.1",
    "prettier": "^3.8.3",
    "react-router-devtools": "^6.2.0",
    "storybook": "^10.4.0",
    "storybook-addon-remix-react-router": "^6.1.0",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-use-logical": "^2.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.16",
    "vite-plugin-prismjs": "^0.0.11",
    "vitest": "^4.1.7",
    "vitest-axe": "^0.1.0"
  }
}
