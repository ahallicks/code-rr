{
  "name": "code-rr",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "build:storybook": "storybook build",
    "dev": "react-router dev",
    "format": "prettier \"{,!(node_modules)/**/}*.js\"",
    "format:write": "prettier \"*/**/*.{js,jsx,ts,tsx,json,md,css,scss}\" --write",
    "lint": "run-p lint:*",
    "lint:js": "eslint \"*/**/*.{js,jsx,ts,tsx}\" --fix",
    "lint:css": "stylelint \"./**/*.{css,scss}\" --fix",
    "lint:ts": "tsc -p tsconfig.json --noEmit && npm run typecheck",
    "new:c": "cross-env HYGEN_TMPLS=generators hygen new component",
    "typecheck": "react-router typegen && tsc",
    "prepare": "husky",
    "start": "react-router-serve ./build/server/index.js",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:pre-commit": "vitest run --changed",
    "test:report": "vitest --reporter=html",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6006"
  },
  "dependencies": {
    "@graphcms/rich-text-react-renderer": "^0.6.2",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@hygraph/preview-sdk": "^1.0.7",
    "@react-router/fs-routes": "^8.2.0",
    "@react-router/node": "8.2.0",
    "@react-router/serve": "8.2.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "graphql": "^17.0.2",
    "graphql-request": "^7.4.0",
    "isbot": "^5.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "8.2.0",
    "react-syntax-highlighter": "^16.1.1"
  },
  "devDependencies": {
    "@axe-core/react": "^4.12.1",
    "@chromatic-com/storybook": "^5.2.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@react-router/dev": "8.2.0",
    "@storybook/addon-a11y": "^10.5.2",
    "@storybook/addon-docs": "^10.5.2",
    "@storybook/addon-onboarding": "^10.5.2",
    "@storybook/addon-vitest": "^10.5.2",
    "@storybook/react-vite": "^10.5.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitejs/devtools": "^0.4.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "cross-env": "^10.1.0",
    "eslint": "^10.7.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-deprecation": "^3.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.5.2",
    "eslint-plugin-testing-library": "^7.16.2",
    "husky": "^9.1.7",
    "hygen": "^6.2.11",
    "install": "^0.13.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "msw": "^2.15.0",
    "npm": "^12.0.1",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.61.1",
    "postcss": "^8.5.19",
    "postcss-custom-media": "^12.0.1",
    "postcss-loader": "^8.2.1",
    "postcss-preset-env": "^11.3.2",
    "postcss-safe-parser": "^7.0.1",
    "prettier": "^3.9.5",
    "react-router-devtools": "^6.2.1",
    "storybook": "^10.5.2",
    "storybook-addon-remix-react-router": "^6.1.0",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-use-logical": "^2.1.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vite-plugin-prismjs": "^0.0.11",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "msw@2.15.0": true,
    "storybook-addon-remix-react-router@6.1.0": true,
    "unrs-resolver@1.12.2": true
  }
}
